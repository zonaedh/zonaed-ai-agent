# ============================================================================
# Zonaed AI Web App — environment variables (plan §9 Step 0, §7)
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# Zod validation in lib/env.ts fails the build fast on any missing key.
# ============================================================================

# --- Supabase (cloud DB + Auth + RLS) ---------------------------------------
# Project Settings -> API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client. Used only by trusted server routes.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers (plan §0: cloud-only, real keys wired from day one) -------
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# --- Rate limiting (plan §7 — required for MVP, Upstash Redis) --------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Sync token signing (plan §2 layer 3) -----------------------------------
# HMAC secret used to sign/verify the scoped, revocable extension sync tokens.
# Generate with: openssl rand -hex 32
SYNC_TOKEN_SECRET=

# --- Cron (plan §5.4 /api/learn daily job, §4 /api/push/cron) ----------------
# Shared secret Vercel Cron sends as Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# --- Web Push (plan §4 /push, Priority 10) -----------------------------------
# Generate a pair with: npx web-push generate-vapid-keys
# The public key is safe to expose (it is sent to every subscribing browser).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact for push services (mailto: or https: URL)
VAPID_SUBJECT=

# --- Monitoring (plan §7) ---------------------------------------------------
# --- Monitoring (plan §7 — optional; leave blank to disable Sentry entirely) ---
# Server-side events (Route Handlers, cron, etc.):
SENTRY_DSN=
# Browser-side events (client components, SSE consumers). Only this public var
# reaches the client bundle; both share the same project DSN value.
NEXT_PUBLIC_SENTRY_DSN=
