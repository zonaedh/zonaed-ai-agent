    "verify:tasks": "tsx scripts/verify-tasks.mts",
    "verify:tools": "tsx scripts/verify-tools.mts",
    "verify:push": "tsx scripts/verify-push.mts",
    "verify:pwa": "tsx scripts/verify-pwa.mts",
    "generate:pwa": "node scripts/generate-pwa-assets.mjs",
